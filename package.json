{
  "name": "iobroker.ai-energy-manager",
  "version": "0.1.1",
  "description": "ioBroker adapter for AI-based dynamic-tariff energy, telemetry, battery and wallbox management.",
  "main": "main.js",
  "scripts": {
    "check": "node --check main.js && node --check lib/*.js && node --check test/*.js",
    "lint": "eslint -c eslint.config.mjs .",
    "lint:fix": "eslint -c eslint.config.mjs . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "build:admin": "vite build --config src-admin/vite.config.js && prettier admin/custom --write && prettier admin/jsonConfig.json5 --write && prettier admin/custom --write",
    "release": "release-script",
    "test": "node --test",
    "test:integration": "npm test",
    "test:package": "npm test",
    "prepublishOnly": "npm run build:admin && npm run check && npm run lint && npm test"
  },
  "keywords": [
    "ioBroker",
    "energy",
    "battery",
    "dynamic-tariff",
    "pv",
    "wallbox"
  ],
  "author": {
    "name": "Christoph Böhrs",
    "email": "git@mr-bond.de"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "admin",
    "lib",
    "main.js",
    "io-package.json",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@iobroker/adapter-core": "^3.3.2"
  },
  "overrides": {
    "diff": "^8.0.3",
    "esbuild": "^0.28.0",
    "serialize-javascript": "^7.0.5"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.0",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.0",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^9.39.4",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/adapter-react-v5": "^8.2.2",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.2.2",
    "@module-federation/runtime": "^2.4.0",
    "@module-federation/vite": "^1.15.4",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^9.0.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "prettier": "^3.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.0.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blabond/ioBroker.ai-energy-manager.git"
  },
  "bugs": {
    "url": "https://github.com/blabond/ioBroker.ai-energy-manager/issues"
  },
  "homepage": "https://github.com/blabond/ioBroker.ai-energy-manager#readme"
}
