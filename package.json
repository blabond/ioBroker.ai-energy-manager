{
    "name": "iobroker.ai-energy-manager",
    "version": "0.4.2",
    "description": "ioBroker adapter for AI-based dynamic-tariff energy, telemetry, battery and wallbox management.",
    "main": "main.js",
    "scripts": {
        "check": "tsc --noEmit && npm run translate:check",
        "lint": "eslint -c eslint.config.mjs .",
        "lint:fix": "eslint -c eslint.config.mjs . --fix",
        "format": "prettier . --write \"!admin/custom/.vite/**\" \"!admin/custom/assets/**\"",
        "format:check": "prettier . --check \"!admin/custom/.vite/**\" \"!admin/custom/assets/**\"",
        "build": "npm run build:admin",
        "build:admin": "vite build --config src-admin/vite.config.js && node scripts/update-admin-cache-bust.js && prettier admin/custom/*.html admin/custom/*.js admin/custom/*.json admin/jsonConfig.json5 --write",
        "release": "release-script",
        "release:verify-tag": "node ./scripts/ensure-release-tag.mjs",
        "test": "node --test \"test/*.test.js\" && npm run test:package",
        "test:integration": "mocha test/integration --exit",
        "test:package": "mocha test/package --exit",
        "prepublishOnly": "npm run release:verify-tag && npm run build:admin && npm run check && npm run lint && npm test",
        "translate": "translate-adapter",
        "translate:check": "node scripts/check-translations.mjs"
    },
    "keywords": [
        "ioBroker",
        "energy",
        "battery",
        "dynamic-tariff",
        "pv",
        "wallbox"
    ],
    "author": {
        "name": "Christoph Böhrs",
        "email": "git@mr-bond.de"
    },
    "license": "MIT",
    "engines": {
        "node": ">=22"
    },
    "files": [
        "admin",
        "lib",
        "main.js",
        "io-package.json",
        "README.md",
        "LICENSE"
    ],
    "dependencies": {
        "@iobroker/adapter-core": "^3.4.2"
    },
    "overrides": {
        "diff": "^8.0.3",
        "esbuild": "^0.28.0",
        "serialize-javascript": "^7.0.5"
    },
    "devDependencies": {
        "@alcalzone/release-script": "^5.2.1",
        "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
        "@alcalzone/release-script-plugin-license": "^5.2.0",
        "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@iobroker/adapter-dev": "^1.5.0",
        "@iobroker/eslint-config": "^2.3.4",
        "@iobroker/testing": "^5.3.0",
        "@module-federation/vite": "^1.16.12",
        "@mui/icons-material": "^9.2.0",
        "@mui/material": "^9.2.0",
        "@tsconfig/node22": "^22.0.5",
        "@types/node": "^22.20.1",
        "@vitejs/plugin-react": "^6.0.3",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "typescript": "^7.0.2",
        "vite": "^8.1.4"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/blabond/ioBroker.ai-energy-manager.git"
    },
    "bugs": {
        "url": "https://github.com/blabond/ioBroker.ai-energy-manager/issues"
    },
    "homepage": "https://github.com/blabond/ioBroker.ai-energy-manager#readme"
}
