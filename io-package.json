    "mode": "daemon",
    "icon": "ai-energy-manager.png",
    "enabled": true,
    "messagebox": true,
    "extIcon": "https://raw.githubusercontent.com/blabond/ioBroker.ai-energy-manager/main/admin/ai-energy-manager.png",
    "readme": "https://github.com/blabond/ioBroker.ai-energy-manager/blob/main/README.md",
    "loglevel": "info",
    "connectionType": "cloud",
    "dataSource": "push",
    "compact": true,
    "adminUI": {
      "config": "json"
    },
    "docs": {
      "en": "README.md",
      "de": "docs/de/README.md"
    },
